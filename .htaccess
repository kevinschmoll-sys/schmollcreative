# KSC — schmollcreative.com
# Hides index.html from URLs, enforces www redirect, caching rules

# ── Enable rewrite engine ─────────────────────────────────────
Options -Indexes
RewriteEngine On

# ── Force www (canonical domain) ─────────────────────────────
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ── Hide index.html from URL ──────────────────────────────────
# Redirect /index.html → / (removes it from address bar)
RewriteCond %{THE_REQUEST} /index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# ── Default document ──────────────────────────────────────────
DirectoryIndex index.html

# ── Cache control ─────────────────────────────────────────────
<IfModule mod_headers.c>
  # HTML/PHP — never cache (updates show immediately)
  <FilesMatch "\.(html|htm|php)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # CSS/JS — 1 hour
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "max-age=3600, must-revalidate"
  </FilesMatch>

  # Images — 7 days
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico)$">
    Header set Cache-Control "max-age=604800"
  </FilesMatch>
</IfModule>
